# Ghostty configuration
# Symlinked to ~/.config/ghostty/config by setup.sh
# Reference: https://ghostty.org/docs/config/reference

# Nerd Font, installed via the Brewfile. The glyph coverage matters:
# robin.zsh-theme's SEGMENT_SEPARATOR is a Powerline glyph and renders as
# tofu in a font without it. Verify the family name with:
#   ghostty +list-fonts | grep Meslo
font-family = MesloLGS Nerd Font Mono
font-size = 12

# Carried over from the old iTerm2 profile
scrollback-limit = 10000

# Left Option sends Meta, so Claude Code's Option+Enter (newline) and Option+P
# (model switch) work, and so do zsh's Alt+B/Alt+F word motions. Only the left
# key: right Option still types special characters like ©, ™, and accents.
macos-option-as-alt = left

# Clickable URLs need no config: link-url and link-previews default to on, and
# the gesture is ⌘-hover then ⌘-click. Both are deliberately absent here so we
# don't pin a default that upstream may improve.
#
# Inside tmux it is ⇧⌘-click instead. tmux.conf sets `mouse on`, so tmux is
# consuming the mouse and Ghostty never gets the hover to match a URL against.
# Shift suppresses the mouse report, handing the click back to Ghostty. This is
# also why mouse-shift-capture is left at its default of false — setting it true
# would send shift to tmux as well and break the escape hatch entirely.
# Plain ⌘-click under tmux is a known upstream gap (ghostty-org/ghostty#3848).
