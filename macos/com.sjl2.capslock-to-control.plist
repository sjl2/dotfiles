<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Maps Caps Lock (0x700000039) to Left Control (0x7000000E0) at login.

  System Settings stores this per keyboard, keyed by vendor/product ID, so it can't
  be scripted ahead of time. A hidutil mapping covers every keyboard instead, but it
  doesn't survive a reboot, which is why this agent re-applies it on each login.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sjl2.capslock-to-control</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x7000000E0}]}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
